{
  "manifest_version": 2,
  "name": "OpenWrt Log Analyzer",
  "version": "1.0",
  "description": "Analyze and filter OpenWrt system and kernel logs",
  "permissions": ["activeTab"],
  "content_scripts": [{
    "matches": ["*://*/*/cgi-bin/luci/admin/status/logs"],
    "css": ["styles/log-viewer.css"],
    "js": ["content/content.js"]
  }],
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}